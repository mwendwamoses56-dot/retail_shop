<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.system.controller.DashboardController"
            stylesheets="@../css/style.css"
            prefWidth="1000" prefHeight="640">

    <!-- TOP BAR -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="12" styleClass="topbar">
            <padding><Insets top="14" right="18" bottom="14" left="18"/></padding>
            <Label text="SIMPLESHOP" styleClass="brand-name"/>
            <Label text="POINT OF SALE" styleClass="brand-caption"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="Products " styleClass="topbar-subtitle"/>
        </HBox>
    </top>

    <!-- CENTER -->
    <center>
        <VBox spacing="14" styleClass="content">
            <padding><Insets top="18" right="18" bottom="18" left="18"/></padding>

            <!-- FORM -->
            <TitledPane text="Product Details" expanded="true" styleClass="card">
                <GridPane hgap="12" vgap="10">
                    <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>

                    <Label text="Name:"     GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                    <TextField fx:id="nameField" promptText="Product name"
                               GridPane.columnIndex="1" GridPane.rowIndex="0" prefWidth="220"/>

                    <Label text="Category:" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                    <ComboBox fx:id="categoryCombo" promptText="Select"
                              GridPane.columnIndex="3" GridPane.rowIndex="0" prefWidth="200"/>

                    <Label text="Price:"    GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                    <TextField fx:id="priceField" promptText="0.00"
                               GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                    <Label text="Stock:"    GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                    <TextField fx:id="stockField" promptText="0"
                               GridPane.columnIndex="3" GridPane.rowIndex="1"/>

                    <HBox spacing="8" GridPane.columnIndex="0" GridPane.rowIndex="2"
                          GridPane.columnSpan="4">
                        <Button text="Add"    fx:id="addButton"    onAction="#handleAdd"    styleClass="btn-primary"/>
                        <Button text="Update" fx:id="updateButton" onAction="#handleUpdate" styleClass="btn-secondary"/>
                        <Button text="Clear"  fx:id="clearButton"  onAction="#handleClear"  styleClass="btn-ghost"/>
                    </HBox>
                </GridPane>
            </TitledPane>

            <!-- SEARCH -->
            <HBox spacing="8" alignment="CENTER_LEFT">
                <Label text="Search:" styleClass="muted"/>
                <TextField fx:id="searchField" promptText="Search by name or category..."
                           HBox.hgrow="ALWAYS" onKeyReleased="#handleSearch" styleClass="search"/>
            </HBox>

            <!-- TABLE -->
            <TableView fx:id="productTable" VBox.vgrow="ALWAYS" styleClass="table">
                <columns>
                    <TableColumn fx:id="colId"       text="ID"       prefWidth="60"/>
                    <TableColumn fx:id="colName"     text="Name"     prefWidth="240"/>
                    <TableColumn fx:id="colCategory" text="Category" prefWidth="160"/>
                    <TableColumn fx:id="colPrice"    text="Price"    prefWidth="120"/>
                    <TableColumn fx:id="colStock"    text="Stock"    prefWidth="90"/>
                </columns>
            </TableView>

            <!-- ACTIONS -->
            <HBox spacing="8" alignment="CENTER_RIGHT">
                <Button text="Delete Selected" fx:id="deleteButton"  onAction="#handleDelete"  styleClass="btn-danger"/>
                <Button text="Refresh"         fx:id="refreshButton" onAction="#handleRefresh" styleClass="btn-ghost"/>
            </HBox>
        </VBox>
    </center>

</BorderPane>